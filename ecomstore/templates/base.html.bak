<script type="text/javascript">
  /*<![CDATA[*/
	$(document).ready(function(){
    		$( 'ul.navonhover li.dropdown' ).hover(function() {
			$(this).toggleClass('open');
    		});

		$("#current_store").change(function() {
			$(".catalogNavigation").hide();
			$("#ShopByDepartment_"+$(this).val()).show();
		})
  	});
  /*]]>*/
</script>

