<div id="fb-root"></div>

	{% load catalog_tags %}

<div class="white-wide-section">
  	<div class="narrow-container header">
		{% include 'tags/defaultHeader.html' %}
		{% include 'tags/g_smallmenus.html' %}
                {% include "tags/op_navigation.html" %}
	</div>
</div>
<div class="cb"></div>
<div id="container">

	<div id="siteContent">
		<div class="siteLayoutFrame">
			{% if request.META.HTTP_HOST  == "www.jetbeamstore.com" %}
				{% if "catalog" in request.path %}
					{% rebate_tag %}
				{% endif %}
			{% endif %}

			{% block site_wrapper %}{% endblock %}
		</div>
	</div>

</div>

<div class="cb"></div>
	{% if request.META.HTTP_HOST == "www.jetbeamstore.com" %}
      	{% include 'tags/tfooter.html' %}
	{% else %}
	{% include 'tags/g_footer.html' %}
	{% endif %}


	{% include 'marketing/google_analytics.html' %}
	{% block receipt_analytics %}{% endblock %}
	{% include 'tags/stumbleupon.html' %}
	{% include 'tags/livechat.html' %}
	{% include 'tags/googletrustedstore.html' %}

  {% include 'tags/zoho.html' %}

